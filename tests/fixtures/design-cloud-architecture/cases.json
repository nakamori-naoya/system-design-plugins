{
  "scenarios": [
    {
      "id": "architecture-success",
      "kind": "success",
      "input": {
        "subject": "状態確認基盤",
        "deployment_constraint": "リージョンA内の単一クラウド管理面",
        "runtime_config_fixture": "../runtime-config/aws.config.yml"
      },
      "expected": {
        "decision": "create_ready_artifact",
        "artifact_fixture": "success.json",
        "mode": "single_cloud",
        "resolved_provider": "aws",
        "provider_source_artifact_id": "SRC-008",
        "selected_capabilities": 12
      }
    },
    {
      "id": "architecture-out-of-scope",
      "kind": "out_of_scope",
      "input": {
        "request": "論理テーブルと索引を再設計し、Terraformを適用して"
      },
      "expected": {
        "decision": "stop_and_route",
        "artifact_fixture": null,
        "reason": "論理データモデル、IaC、配置は非責務"
      }
    },
    {
      "id": "single-to-multi-cloud-boundary",
      "kind": "boundary",
      "base": {
        "mode": "single_cloud",
        "condition": "単一プロバイダー運用制約と、そのプロバイダーで要求を満たす検証可能な案がある"
      },
      "one_change": {
        "condition": "独立した2プロバイダーで責任を分割する契約要求だけが追加される"
      },
      "expected": {
        "changed_mode": "multi_cloud",
        "required": [
          "2つのプロバイダー範囲",
          "障害の独立性",
          "データと運用のトレードオフ"
        ],
        "must_not": "プロバイダー名を2件並べただけでマルチクラウドとしない"
      }
    },
    {
      "id": "single-to-hybrid-boundary",
      "kind": "boundary",
      "base": {
        "mode": "single_cloud",
        "condition": "オンプレミスの責任境界がない"
      },
      "one_change": {
        "condition": "システム所有のオンプレミス依存とデータの流れだけが追加される"
      },
      "expected": {
        "changed_mode": "hybrid",
        "required": [
          "オンプレミス境界",
          "信頼境界の通過",
          "接続障害時の挙動"
        ],
        "must_not": "接続製品を先に選ばない"
      }
    },
    {
      "id": "on-prem-boundary",
      "kind": "boundary",
      "base": {
        "mode": "hybrid",
        "condition": "クラウドのプロバイダー範囲が1件ある"
      },
      "one_change": {
        "condition": "クラウド利用許可だけが撤回され、プロバイダー範囲が空になる"
      },
      "expected": {
        "changed_mode": "on_prem",
        "required": [
          "クラウドのプロバイダー範囲が0件",
          "クラウド機能領域が非該当"
        ],
        "must_not": "クラウドプロバイダーを仮置きしない"
      }
    },
    {
      "id": "cloud-undecided-boundary",
      "kind": "boundary",
      "base": {
        "mode": "single_cloud",
        "condition": "プロバイダーの採用決定と根拠がある"
      },
      "one_change": {
        "condition": "プロバイダーの採用決定だけが撤回される"
      },
      "expected": {
        "changed_mode": "cloud_undecided",
        "state": "saved_with_open_questions",
        "required": [
          "プロバイダーとサービスの選択がnull",
          "作業を止める問い",
          "候補比較"
        ],
        "must_not": "人気だけでプロバイダーを選ばない"
      }
    }
  ]
}
